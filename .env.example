# Supabase — copy this file to .env and fill in your project values.
# Get them from your Supabase dashboard: Project Settings -> API.
# These are safe for the browser (the anon key is a publishable key, protected by RLS).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
